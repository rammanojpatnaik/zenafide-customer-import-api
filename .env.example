# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never use this placeholder value in production.
JWT_SECRET_KEY=replace-with-a-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to false in production so demo credentials are never seeded.
SEED_DEMO_USERS=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=change-me

LOG_LEVEL=INFO
LOG_FILE=/var/log/zenafide/app.log
UPLOAD_DIR=/var/lib/zenafide/uploads
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage backend: "local" (single-host Docker) or "s3" (multi-service cloud)
STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=s3:
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_ENDPOINT_URL=https://...  # optional, for R2/MinIO/etc.
